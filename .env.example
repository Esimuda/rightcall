# Tatum Sui GraphQL. The live gateway serves GraphQL, not JSON-RPC.
# POST https://sui-mainnet.gateway.tatum.io/graphql
# Header: x-api-key
# JSON-RPC POST to the gateway root returns 404 on a free key.
TATUM_API_KEY=

# Hackathon form only. The desk does not read these.
TATUM_ACCOUNT_ID=
TATUM_ORG_ID=

# Optional. RightCall does not call gRPC.
# TATUM_SUI_GRPC=https://sui-mainnet-grpc.gateway.tatum.io

# Set to 0 to refuse the public Sui GraphQL fallback when TATUM_API_KEY is empty.
# A failed Tatum key never falls back, even if this stays unset.
RIGHTCALL_PUBLIC_SUI_FALLBACK=1

# Walrus Memory mainnet. Create the account and delegate key at https://memory.walrus.xyz
# Use one of the key names. The hosted relayer pays the storage.
MEMWAL_KEY=
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=rightcall
# The Walrus UI does not issue an agent id for this delegate. Leave unset. N/A.
# MEMWAL_AGENT_ID=
